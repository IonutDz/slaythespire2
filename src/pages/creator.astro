---
import "./global.css";
import spireData from "../data/spire-data.json";
import { buildGuides } from "../data/buildGuides";

const payload = JSON.stringify({ spireData, buildGuides }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Slay the Shadow 2 - Creador de Builds</title>
    <meta
      name="description"
      content="Creador de builds para Slay the Spire 2. Elige cartas y descubre qué builds encajan."
    />
  </head>
  <body>
    <div class="app-shell">
      <header class="topbar">
        <a class="home-logo" href="/" title="Slay the Shadow 2">
          <img src="/favicon.svg" width="36" height="36" alt="Slay the Shadow 2 Logo" style="filter: drop-shadow(0 0 8px rgba(217, 178, 99, 0.4));" />
          <span class="logo-text">Slay the Shadow 2</span>
        </a>
        <div class="topbar-center">
          <h1 id="pageTitle">Creador de Builds</h1>
        </div>
        <div class="topbar-actions">
          <a class="nav-link" href="/">Portal</a>
          <a class="nav-link" href="/cards">Cartas</a>
          <a class="nav-link" href="/relics">Reliquias</a>
          <a class="nav-link" href="/runs">Partidas</a>
          <a class="nav-link active" href="/creator">Creador</a>
          <div class="lang-toggle" id="langToggle" aria-label="Language">
            <button type="button" data-lang="es">ES</button>
            <button type="button" data-lang="en">EN</button>
          </div>
        </div>
      </header>

      <main class="creator-shell">
        <section class="class-section">
          <div class="section-heading">
            <p class="eyebrow" id="step1Label">Paso 1</p>
            <h2 id="classSectionTitle">Elige una clase (opcional)</h2>
          </div>
          <div id="classTabs" class="class-tabs"></div>
        </section>

        <section class="search-section">
          <div class="section-heading">
            <p class="eyebrow" id="step2Label">Paso 2</p>
            <h2 id="searchSectionTitle">Busca y añade cartas</h2>
          </div>
          <label class="field full">
            <span id="searchLabel">Buscar carta</span>
            <input id="cardSearch" type="search" placeholder="Haunt, Glacier, Blade Dance..." />
          </label>
          <div id="searchResults" class="search-results"></div>
        </section>

        <section class="deck-section">
          <div class="deck-header">
            <div>
              <p class="eyebrow" id="deckLabel">Tu mazo</p>
              <h2 id="deckTitle">0 cartas</h2>
            </div>
            <button id="clearDeck" class="reset-button" type="button">Limpiar</button>
          </div>
          <div id="deckGrid" class="deck-grid"></div>
          <p id="deckEmpty" class="empty-state">Busca cartas arriba para añadirlas a tu mazo.</p>
        </section>

        <section class="results-section">
          <div class="section-heading">
            <p class="eyebrow" id="resultsLabel">Builds recomendadas</p>
            <h2 id="resultsTitle">Basado en tus cartas</h2>
          </div>
          <p id="resultsEmpty" class="empty-state">Añade cartas para ver qué builds encajan con tu selección.</p>
          <div id="buildResults" class="build-results"></div>
        </section>
      </main>

      <dialog id="buildDialog" class="build-dialog">
        <article class="dialog-panel">
          <button id="buildDialogClose" class="dialog-close" type="button" aria-label="Cerrar">×</button>
          <div id="buildDialogBody" class="dialog-body"></div>
        </article>
      </dialog>

      <dialog id="cardDialog" class="card-dialog">
        <article class="dialog-panel">
          <button id="cardDialogClose" class="dialog-close" type="button" aria-label="Cerrar">×</button>
          <div id="cardDialogBody" class="dialog-body"></div>
        </article>
      </dialog>
    </div>

    <script is:inline id="creatorData" type="application/json" set:html={payload}></script>
    <script is:inline type="module">
      const { spireData, buildGuides } = JSON.parse(document.getElementById("creatorData").textContent);
      const IMAGE_BASE = "https://spire-codex.com";
      const allCards = spireData.allCards || Object.values(spireData.cardsByClass).flat();
      const classSlugs = ["ironclad", "silent", "defect", "regent", "necrobinder"];

      const copy = {
        es: {
          pageTitle: "Creador de Builds",
          step1: "Paso 1",
          step2: "Paso 2",
          classSectionTitle: "Elige una clase (opcional)",
          allClasses: "Todas",
          searchSectionTitle: "Busca y añade cartas",
          searchLabel: "Buscar carta",
          searchPlaceholder: "Haunt, Glacier, Blade Dance...",
          deckLabel: "Tu mazo",
          deckTitle: "cartas",
          clear: "Limpiar",
          deckEmpty: "Busca cartas arriba para añadirlas a tu mazo.",
          resultsLabel: "Builds recomendadas",
          resultsTitle: "Basado en tus cartas",
          resultsEmpty: "Añade cartas para ver qué builds encajan con tu selección.",
          add: "Añadir",
          remove: "Quitar",
          roleCore: "Core",
          roleEnabler: "Habilitador",
          rolePayoff: "Payoff",
          roleSafe: "Pick seguro",
          roleAvoid: "Evitar",
          noMatch: "Sin coincidencias.",
          matchScore: "puntos de afinidad",
          matchedCards: "cartas que encajan",
          buildGoal: "Objetivo",
          earlyPlan: "Plan temprano",
          breakpoints: "Breakpoints",
          draftRules: "Reglas de draft",
          core: "Núcleo",
          enablers: "Habilitadoras",
          payoffs: "Pagos",
          safePicks: "Picks seguros",
          avoid: "Evitar",
          close: "Cerrar",
          baseDescription: "Descripción",
          upgradeDescription: "Mejora",
          stats: "Datos",
          source: "Abrir en Spire Codex",
          whyCore: "pieza núcleo de",
          whyEnabler: "habilita el plan de",
          whyPayoff: "payoff de",
          whySafe: "pick seguro para",
          whyAvoid: "evitar en",
        },
        en: {
          pageTitle: "Build Creator",
          step1: "Step 1",
          step2: "Step 2",
          classSectionTitle: "Choose a class (optional)",
          allClasses: "All",
          searchSectionTitle: "Search and add cards",
          searchLabel: "Search card",
          searchPlaceholder: "Haunt, Glacier, Blade Dance...",
          deckLabel: "Your deck",
          deckTitle: "cards",
          clear: "Clear",
          deckEmpty: "Search for cards above to add them to your deck.",
          resultsLabel: "Recommended builds",
          resultsTitle: "Based on your cards",
          resultsEmpty: "Add cards to see which builds match your selection.",
          add: "Add",
          remove: "Remove",
          roleCore: "Core",
          roleEnabler: "Enabler",
          rolePayoff: "Payoff",
          roleSafe: "Safe pick",
          roleAvoid: "Avoid",
          noMatch: "No matches.",
          matchScore: "affinity points",
          matchedCards: "matching cards",
          buildGoal: "Goal",
          earlyPlan: "Early Plan",
          breakpoints: "Breakpoints",
          draftRules: "Draft Rules",
          core: "Core",
          enablers: "Enablers",
          payoffs: "Payoffs",
          safePicks: "Safe Picks",
          avoid: "Avoid",
          close: "Close",
          baseDescription: "Description",
          upgradeDescription: "Upgrade",
          stats: "Stats",
          source: "Open in Spire Codex",
          whyCore: "core piece of",
          whyEnabler: "enables the plan of",
          whyPayoff: "payoff for",
          whySafe: "safe pick for",
          whyAvoid: "avoid in",
        },
      };

      const classAccents = {
        ironclad: "#d65a45",
        silent: "#46a96f",
        defect: "#4d8be8",
        regent: "#d88b35",
        necrobinder: "#9d68d8",
      };

      const buildSections = [
        ["core", "roleCore", 40],
        ["enablers", "roleEnabler", 30],
        ["payoffs", "rolePayoff", 30],
        ["safePicks", "roleSafe", 15],
        ["avoid", "roleAvoid", -50],
      ];

      const buildCatalog = Object.values(buildGuides || {}).flatMap((guide) =>
        (guide.builds || []).map((build) => ({ guide, build }))
      );

      let nextInstanceId = 1;
      const state = {
        lang: localStorage.getItem("sts2-lang") || "es",
        classSlug: null,
        deck: [],
        query: "",
      };

      const els = {
        pageTitle: document.getElementById("pageTitle"),
        langToggle: document.getElementById("langToggle"),
        step1Label: document.getElementById("step1Label"),
        step2Label: document.getElementById("step2Label"),
        classSectionTitle: document.getElementById("classSectionTitle"),
        classTabs: document.getElementById("classTabs"),
        searchSectionTitle: document.getElementById("searchSectionTitle"),
        searchLabel: document.getElementById("searchLabel"),
        cardSearch: document.getElementById("cardSearch"),
        searchResults: document.getElementById("searchResults"),
        deckLabel: document.getElementById("deckLabel"),
        deckTitle: document.getElementById("deckTitle"),
        clearDeck: document.getElementById("clearDeck"),
        deckGrid: document.getElementById("deckGrid"),
        deckEmpty: document.getElementById("deckEmpty"),
        resultsLabel: document.getElementById("resultsLabel"),
        resultsTitle: document.getElementById("resultsTitle"),
        resultsEmpty: document.getElementById("resultsEmpty"),
        buildResults: document.getElementById("buildResults"),
        buildDialog: document.getElementById("buildDialog"),
        buildDialogBody: document.getElementById("buildDialogBody"),
        buildDialogClose: document.getElementById("buildDialogClose"),
        cardDialog: document.getElementById("cardDialog"),
        cardDialogBody: document.getElementById("cardDialogBody"),
        cardDialogClose: document.getElementById("cardDialogClose"),
      };

      function t(key) {
        return copy[state.lang]?.[key] || copy.es[key] || key;
      }

      function escapeHtml(value = "") {
        return String(value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function fold(value = "") {
        return String(value).normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
      }

      function normalizeName(value = "") {
        return fold(value).replace(/[^a-z0-9]+/g, " ").trim();
      }

      function cardName(card) {
        return state.lang === "es" && card.localized?.es?.name ? card.localized.es.name : card.name;
      }

      function cardDescription(card) {
        return state.lang === "es" && card.localized?.es?.description ? card.localized.es.description : card.description || "";
      }

      function cardType(card) {
        if (state.lang === "es" && card.localized?.es?.type) return card.localized.es.type;
        return card.type;
      }

      function cardRarity(card) {
        if (state.lang === "es" && card.localized?.es?.rarity) return card.localized.es.rarity;
        return card.rarity;
      }

      function costLabel(card) {
        if (card.is_x_cost || card.cost === -1) return "X";
        if (card.is_x_star_cost) return "XS";
        if (card.star_cost) return `${card.star_cost}S`;
        return String(card.cost);
      }

      function colorLabel(color) {
        const map = {
          es: { ironclad: "Ironclad", silent: "Silent", defect: "Defect", regent: "Regent", necrobinder: "Necrobinder", colorless: "Incolora" },
          en: { ironclad: "Ironclad", silent: "Silent", defect: "Defect", regent: "Regent", necrobinder: "Necrobinder", colorless: "Colorless" },
        };
        return map[state.lang]?.[color] || color;
      }

      function normalizeUrl(url) {
        if (!url) return "";
        return url.startsWith("http") ? url : `${IMAGE_BASE}${url}`;
      }

      function cleanText(text = "") {
        return text
          .replace(/\[gold\]|\[\/gold\]/g, "")
          .replace(/\[energy:(\d)\]/g, "$1E")
          .replace(/\[star:(\d)\]/g, "$1S")
          .replace(/\[purple\]|\[\/purple\]/g, "")
          .replace(/\n/g, " ");
      }

      function cardAliases(card) {
        return [...new Set([card.name, card.localized?.es?.name, cardName(card)].filter(Boolean).map(normalizeName))].filter(Boolean);
      }

      function getSearchableCards() {
        if (state.classSlug) return spireData.cardsByClass[state.classSlug] || [];
        return allCards.filter((c) => classSlugs.includes(c.color));
      }

      function renderStaticText() {
        document.documentElement.lang = state.lang;
        els.pageTitle.textContent = t("pageTitle");
        els.step1Label.textContent = t("step1");
        els.step2Label.textContent = t("step2");
        els.classSectionTitle.textContent = t("classSectionTitle");
        els.searchSectionTitle.textContent = t("searchSectionTitle");
        els.searchLabel.textContent = t("searchLabel");
        els.cardSearch.placeholder = t("searchPlaceholder");
        els.deckLabel.textContent = t("deckLabel");
        els.clearDeck.textContent = t("clear");
        els.deckEmpty.textContent = t("deckEmpty");
        els.resultsLabel.textContent = t("resultsLabel");
        els.resultsTitle.textContent = t("resultsTitle");
        els.resultsEmpty.textContent = t("resultsEmpty");
        els.langToggle.querySelectorAll("button").forEach((button) => {
          button.classList.toggle("active", button.dataset.lang === state.lang);
          button.setAttribute("aria-pressed", String(button.dataset.lang === state.lang));
        });
      }

      function renderClassTabs() {
        const tabs = [
          `<button type="button" class="class-tab ${!state.classSlug ? "active" : ""}" data-class="" style="--accent: var(--gold)">${t("allClasses")}</button>`,
          ...spireData.characters.map((character) => {
            const slug = character.id.toLowerCase();
            const guide = buildGuides[slug];
            return `
              <button type="button" class="class-tab ${slug === state.classSlug ? "active" : ""}" data-class="${slug}" style="--accent:${guide.accent}">
                <img src="${normalizeUrl(character.image_url)}" alt="" />
                <span>${character.name.replace("The ", "")}</span>
              </button>
            `;
          }),
        ];
        els.classTabs.innerHTML = tabs.join("");
      }

      function renderSearch() {
        const query = fold(els.cardSearch.value.trim());
        if (!query) {
          els.searchResults.innerHTML = "";
          return;
        }

        const deckIds = new Set(state.deck.map((c) => c.id));
        const cards = getSearchableCards()
          .filter((card) => !deckIds.has(card.id))
          .filter((card) => {
            return fold(
              `${card.name} ${card.description} ${card.type} ${card.rarity} ${card.color} ${cardName(card)} ${cardDescription(card)} ${cardType(card)} ${cardRarity(card)} ${colorLabel(card.color)}`
            ).includes(query);
          })
          .slice(0, 10);

        if (!cards.length) {
          els.searchResults.innerHTML = `<p class="empty-state">${t("noMatch")}</p>`;
          return;
        }

        els.searchResults.innerHTML = cards
          .map(
            (card) => `
              <button type="button" class="search-result color-${escapeHtml(card.color)}" data-add-id="${escapeHtml(card.id)}">
                <img src="${normalizeUrl(card.image_url)}" alt="" loading="lazy" />
                <div class="search-result-info">
                  <strong>${escapeHtml(cardName(card))}</strong>
                  <small>${escapeHtml(colorLabel(card.color))} · ${escapeHtml(cardType(card))} · ${costLabel(card)}</small>
                </div>
                <span class="add-btn">${escapeHtml(t("add"))}</span>
              </button>
            `
          )
          .join("");
      }

      function renderDeck() {
        const count = state.deck.length;
        els.deckTitle.textContent = `${count} ${t("deckTitle")}`;
        els.deckEmpty.style.display = count ? "none" : "block";

        els.deckGrid.innerHTML = state.deck
          .map(
            (card) => `
              <article class="deck-card color-${escapeHtml(card.color)}" data-instance-id="${card.instanceId}">
                <img src="${normalizeUrl(card.image_url)}" alt="" loading="lazy" />
                <div class="deck-card-info">
                  <strong>${escapeHtml(cardName(card))}</strong>
                  <small>${costLabel(card)} · ${escapeHtml(cardType(card))}</small>
                </div>
                <button type="button" class="remove-btn" data-remove-instance-id="${card.instanceId}">${escapeHtml(t("remove"))}</button>
              </article>
            `
          )
          .join("");
      }

      function computeRecommendations() {
        if (!state.deck.length) return [];

        const deckAliases = state.deck.map((card) => ({ card, aliases: cardAliases(card) }));

        const results = buildCatalog
          .map(({ guide, build }) => {
            if (state.classSlug && guide.slug !== state.classSlug) return null;

            let score = 0;
            const matches = [];

            buildSections.forEach(([section, roleKey, weight]) => {
              (build[section] || []).forEach((entry) => {
                const normalizedEntry = normalizeName(entry);
                deckAliases.forEach(({ card, aliases }) => {
                  if (aliases.some((alias) => normalizedEntry === alias || normalizedEntry.includes(alias) || alias.includes(normalizedEntry))) {
                    score += weight;
                    matches.push({ card, section, roleKey, weight });
                  }
                });
              });
            });

            return { guide, build, score, matches };
          })
          .filter(Boolean)
          .filter((r) => r.score > 0)
          .sort((a, b) => b.score - a.score);

        return results;
      }

      function renderResults() {
        const results = computeRecommendations();
        if (!results.length) {
          els.resultsEmpty.style.display = state.deck.length ? "none" : "block";
          els.buildResults.innerHTML = state.deck.length ? `<p class="empty-state">${t("resultsEmpty")}</p>` : "";
          return;
        }

        els.resultsEmpty.style.display = "none";
        els.buildResults.innerHTML = results
          .map(
            ({ guide, build, score, matches }) => {
              const accent = classAccents[guide.slug] || "var(--gold)";
              const positiveMatches = matches.filter((m) => m.weight > 0);
              return `
                <article class="build-result color-${escapeHtml(guide.slug)}" style="--match-accent: ${accent}" data-build-id="${escapeHtml(build.id)}" data-guide-slug="${escapeHtml(guide.slug)}">
                  <div class="build-result-top">
                    <div>
                      <strong>${escapeHtml(build.name)}</strong>
                      <small>${escapeHtml(guide.name)} · ${escapeHtml(build.label)}</small>
                    </div>
                    <div class="build-score">
                      <span>${score}</span>
                      <small>${escapeHtml(t("matchScore"))}</small>
                    </div>
                  </div>
                  <p class="build-goal"><b>${escapeHtml(t("buildGoal"))}:</b> ${escapeHtml(build.goal)}</p>
                  <div class="build-match-list">
                    ${positiveMatches
                      .map(
                        ({ card, section, roleKey }) => `
                          <div class="build-match-entry role-${section}">
                            <span>${escapeHtml(cardName(card))}</span>
                            <b>${escapeHtml(t(roleKey))}</b>
                          </div>
                        `
                      )
                      .join("")}
                    ${matches
                      .filter((m) => m.weight < 0)
                      .map(
                        ({ card, roleKey }) => `
                          <div class="build-match-entry is-warning">
                            <span>${escapeHtml(cardName(card))}</span>
                            <b>${escapeHtml(t(roleKey))}</b>
                          </div>
                        `
                      )
                      .join("")}
                  </div>
                </article>
              `;
            }
          )
          .join("");
      }

      function cardSlug(card) {
        const image = card.image_url || "";
        return image.split("/").pop()?.replace(/\.(webp|png|jpg|jpeg)$/i, "") || card.id.toLowerCase();
      }

      function cardUrl(card) {
        const prefix = state.lang === "es" ? "/spa" : "";
        return `${IMAGE_BASE}${prefix}/cards/${cardSlug(card)}`;
      }

      function statRows(card) {
        return [
          [t("buildGoal"), colorLabel(card.color)],
          [cardType(card)],
          [cardRarity(card)],
          [costLabel(card)],
        ].filter(([v]) => v).join(" · ");
      }

      function openCardDialog(card) {
        const name = cardName(card);
        const desc = cleanText(cardDescription(card)) || "";
        const upgrade = card.localized?.es?.upgrade_description || card.upgrade_description || "";
        const upgradeText = cleanText(upgrade);
        els.cardDialogBody.innerHTML = `
          <div class="dialog-art">
            <img src="${normalizeUrl(card.image_url)}" alt="${escapeHtml(name)}" />
          </div>
          <div class="dialog-info">
            <p class="eyebrow">${escapeHtml(colorLabel(card.color))}</p>
            <h2>${escapeHtml(name)}</h2>
            <div class="meta-row">
              <span>${escapeHtml(cardType(card))}</span>
              <span>${escapeHtml(cardRarity(card))}</span>
              <span>${costLabel(card)}</span>
            </div>
            ${desc ? `<section class="dialog-section"><h3>${escapeHtml(t("baseDescription"))}</h3><p>${escapeHtml(desc)}</p></section>` : ""}
            ${upgradeText ? `<section class="dialog-section"><h3>${escapeHtml(t("upgradeDescription"))}</h3><p>${escapeHtml(upgradeText)}</p></section>` : ""}
            <a class="source-link" href="${cardUrl(card)}" target="_blank" rel="noreferrer">${escapeHtml(t("source"))}</a>
          </div>
        `;
        els.cardDialog.showModal();
      }

      function openBuildDialog(guide, build, matches) {
        const accent = classAccents[guide.slug] || "var(--gold)";
        const sections = [
          ["core", t("core")],
          ["enablers", t("enablers")],
          ["payoffs", t("payoffs")],
          ["safePicks", t("safePicks")],
          ["avoid", t("avoid")],
        ];
        const deckNames = new Set(state.deck.map((c) => c.name));
        const deckAliasSet = new Set(state.deck.flatMap((c) => cardAliases(c)));
        els.buildDialogBody.innerHTML = `
          <div class="dialog-info">
            <p class="eyebrow">${escapeHtml(guide.name)} · ${escapeHtml(build.label)}</p>
            <h2>${escapeHtml(build.name)}</h2>
            <p class="build-goal">${escapeHtml(build.goal)}</p>
            ${sections.map(([key, label]) => {
              const items = (build[key] || []).filter(Boolean);
              if (!items.length) return "";
              return `
                <section class="dialog-section">
                  <h3>${escapeHtml(label)}</h3>
                  <div class="chip-row">
                    ${items.map((name) => {
                      const isInDeck = deckAliasSet.has(normalizeName(name));
                      return `<span class="chip ${isInDeck ? "in-deck" : ""} ${key === "avoid" ? "is-warn" : ""}">${escapeHtml(name)}${isInDeck ? " ✓" : ""}</span>`;
                    }).join("")}
                  </div>
                </section>
              `;
            }).join("")}
            ${build.earlyPlan?.length ? `
              <section class="dialog-section">
                <h3>${escapeHtml(t("earlyPlan"))}</h3>
                <ul class="clean-list">${build.earlyPlan.map((s) => `<li>${escapeHtml(s)}</li>`).join("")}</ul>
              </section>
            ` : ""}
            ${build.breakpoints?.length ? `
              <section class="dialog-section">
                <h3>${escapeHtml(t("breakpoints"))}</h3>
                <ul class="clean-list">${build.breakpoints.map((s) => `<li>${escapeHtml(s)}</li>`).join("")}</ul>
              </section>
            ` : ""}
          </div>
        `;
        els.buildDialog.showModal();
      }

      function renderAll() {
        renderStaticText();
        renderClassTabs();
        renderSearch();
        renderDeck();
        renderResults();
      }

      els.langToggle.addEventListener("click", (event) => {
        const button = event.target.closest("[data-lang]");
        if (!button) return;
        state.lang = button.dataset.lang;
        localStorage.setItem("sts2-lang", state.lang);
        renderAll();
      });

      els.classTabs.addEventListener("click", (event) => {
        const button = event.target.closest("[data-class]");
        if (!button) return;
        state.classSlug = button.dataset.class || null;
        state.deck = [];
        
        if (state.classSlug) {
          const character = spireData.characters.find(
            (c) => c.id.toLowerCase() === state.classSlug
          );
          if (character && character.starting_deck) {
            character.starting_deck.forEach((cardId) => {
              const targetId = cardId.replace(/([a-z0-9])([A-Z])/g, "$1_$2").toUpperCase();
              const foundCard = allCards.find((c) => c.id === targetId);
              if (foundCard) {
                state.deck.push({ ...foundCard, instanceId: nextInstanceId++ });
              }
            });
          }
        }
        
        els.cardSearch.value = "";
        state.query = "";
        renderAll();
      });

      els.cardSearch.addEventListener("input", () => {
        state.query = els.cardSearch.value;
        renderSearch();
      });

      // Add card from search results
      els.searchResults.addEventListener("click", (event) => {
        const button = event.target.closest("[data-add-id]");
        if (!button) return;
        const cardId = button.dataset.addId;
        const card = allCards.find((c) => c.id === cardId);
        if (card) {
          state.deck.push({ ...card, instanceId: nextInstanceId++ });
          els.cardSearch.value = "";
          state.query = "";
          renderAll();
        }
      });

      // Remove card or view stats in deck grid
      els.deckGrid.addEventListener("click", (event) => {
        const removeBtn = event.target.closest("[data-remove-instance-id]");
        if (removeBtn) {
          event.stopPropagation();
          const instanceId = parseInt(removeBtn.dataset.removeInstanceId, 10);
          state.deck = state.deck.filter((c) => c.instanceId !== instanceId);
          renderAll();
          return;
        }

        const cardEl = event.target.closest("[data-instance-id]");
        if (cardEl) {
          const instanceId = parseInt(cardEl.dataset.instanceId, 10);
          const card = state.deck.find((c) => c.instanceId === instanceId);
          if (card) {
            openCardDialog(card);
          }
        }
      });

      // Clear deck workspace
      els.clearDeck.addEventListener("click", () => {
        state.deck = [];
        els.cardSearch.value = "";
        state.query = "";
        renderAll();
      });

      // View build recommendation details
      els.buildResults.addEventListener("click", (event) => {
        const buildCard = event.target.closest("[data-build-id]");
        if (!buildCard) return;
        const buildId = buildCard.dataset.buildId;
        const guideSlug = buildCard.dataset.guideSlug;
        const result = buildCatalog.find(
          (r) => r.build.id === buildId && r.guide.slug === guideSlug
        );
        if (result) {
          // Compute matching cards details
          const deckAliases = state.deck.map((c) => ({ card: c, aliases: cardAliases(c) }));
          const matches = [];
          buildSections.forEach(([section, roleKey, weight]) => {
            (result.build[section] || []).forEach((entry) => {
              const normalizedEntry = normalizeName(entry);
              deckAliases.forEach(({ card, aliases }) => {
                if (
                  aliases.some(
                    (alias) =>
                      normalizedEntry === alias ||
                      normalizedEntry.includes(alias) ||
                      alias.includes(normalizedEntry)
                  )
                ) {
                  matches.push({ card, section, roleKey, weight });
                }
              });
            });
          });
          openBuildDialog(result.guide, result.build, matches);
        }
      });

      // Dialog Close Controls & Click Outside Backdrop
      els.buildDialogClose.addEventListener("click", () => els.buildDialog.close());
      els.cardDialogClose.addEventListener("click", () => els.cardDialog.close());

      els.buildDialog.addEventListener("click", (e) => {
        if (e.target === els.buildDialog) els.buildDialog.close();
      });
      els.cardDialog.addEventListener("click", (e) => {
        if (e.target === els.cardDialog) els.cardDialog.close();
      });

      renderAll();
    </script>
  </body>
</html>

